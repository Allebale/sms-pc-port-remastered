 // port: extensions hear of each hit this game's player (or its water) lands,
 // and may stop one (port_ext.h: ext/multiplayer passes them to the other games)
+// Split-screen co-op (ext/coop/game/coop.cpp): whose each drop is, and a drop's hit taken with
+// the game's player globals (Mario's place and facing) its player's, so the push is from them
+extern "C" void port_water_drop_made(int slot);
+extern "C" void port_water_drop_moved(int to, int from);
+extern "C" int port_coop_drop_hit_begin(THitActor* drop);
+extern "C" void port_coop_drop_hit_end(int began);
+
 static inline BOOL portHit(THitActor* to, THitActor* from, u32 message)
 {
 	if (port_ext_object_hit(to, from, message))
 		return FALSE;
+	const int sms_coop_b = port_coop_drop_hit_begin(from);
 	const BOOL sms_ext_r = to->receiveMessage(from, message);
 	port_ext_object_hit_done(to, from, message, sms_ext_r);
+	port_coop_drop_hit_end(sms_coop_b);
 	return sms_ext_r;
 }
 
